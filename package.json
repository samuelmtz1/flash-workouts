{
  "name": "flash-workouts",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "secretlint": "^13.1.0",
    "typescript": "~7.0.2",
    "workbox-cli": "^7.4.1"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "jest",
    "build:web": "expo export -p web && workbox generateSW workbox-config.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "secrets": "secretlint \"**/*\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run secrets"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/web"
  }
}
